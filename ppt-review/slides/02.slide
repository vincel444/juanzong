    <Text style={{ fontSize: 14, color: '#94A3B8', letterSpacing: 3 }}>01 · 我们做什么</Text>
  </Box>
  <Box style={{ flex: 1, flexDirection: 'row', gap: 40, marginTop: 16, alignItems: 'center' }}>
